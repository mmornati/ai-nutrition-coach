# Build-context whitelist for the self-host Docker image (infra/Dockerfile).
# Keeps the context small + reproducible by excluding anything the web build does not need.

# Dependencies and build output are produced INSIDE the image from the lockfile.
**/node_modules/
**/dist/
**/dist-e2e/
**/dev-dist/
**/coverage/
**/test-results/
**/playwright-report/
**/.vite/
**/*.tsbuildinfo

# The pinned, hash-verified wasm assets are fetched inside the image (cached layer), never taken
# from the local checkout.
apps/web/public/sqlite3mc/
apps/web/public/zxing/

# Editor / OS noise
**/.idea/
**/.vscode/
**/.DS_Store
**/*.iml

# VCS metadata (git metadata is not needed in the image)
**/.git/
**/.gitattributes

# CI / docs / governance that the runtime does not need
**/.github/
**/docs/
**/_bmad-output/
**/_bmad/

# Secrets and local tooling must never enter the build context.
**/.env
**/.env.*
!**/.env.example
.claude/

# Browser smoke and self-host smoke (they run against the built image, not inside it)
scripts/smoke_self_host.sh
scripts/webkit_smoke.sh
tools/webkit_smoke/

# Signing material / machine-local config.
**/key.properties
**/*.jks
**/*.keystore
**/local.properties
