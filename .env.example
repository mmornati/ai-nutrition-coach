# ─────────────────────────────────────────────────────────────────────────────
# AI Nutrition Coach local runtime configuration — for the developer's machine only.
#
# This file is gitignored when copied to `.env` (`.gitignore` keeps `.env` and
# `.env.*` out of the repo; `.dockerignore` keeps them out of the build
# context). Copy it from `.env.example` and fill in your own values.
#
# NO SECRETS GO HERE. Not an API key, not a token. Everything below is turned
# into a `--dart-define` and COMPILED INTO the web bundle, which anyone who can
# load the app can read. `scripts/run_local_web.sh` reads this file as data
# (it is never executed), uses only the three names below, and ignores — with
# a notice — anything that looks like a secret. Your BYOK API key is typed into
# Settings → Your AI at run time (kept in the OS keystore on mobile, in memory
# only on web).
#
# All variables are optional.
# ─────────────────────────────────────────────────────────────────────────────

# Dev-only: use the in-memory web store so the capture → log → Day Board loop
# works in the browser without the passphrase flow. Data lives and dies with the
# tab, and the app shows a red DEV banner.
AI_NUTRITION_COACH_DEV_IN_MEMORY_STORE=true

# A default OpenAI-compatible endpoint + model to PRE-FILL the Your AI form.
# Not secret; they do not turn the AI on (you still choose the rung and paste a
# key in the app). The endpoint must be https:// (http:// only for localhost).
AI_NUTRITION_COACH_BYOK_ENDPOINT_URL=https://openrouter.ai/api/v1
AI_NUTRITION_COACH_BYOK_MODEL=google/gemini-2.0-flash-exp:free
