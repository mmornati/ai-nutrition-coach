# ─────────────────────────────────────────────────────────────────────────────
# OpenPlate local runtime configuration — for the developer's machine only.
#
# This file is gitignored (`.gitignore` keeps `.env` and `.env.*` out of the
# repo). Copy it from `.env.example` and fill in your own values. NEVER commit
# an API key to this repo.
#
# Values here are forwarded by `scripts/run_local_web.sh` as `--dart-define`
# flags into the Flutter web build, and read at runtime by `BuildConfig`
# (packages/integrations/lib/src/config/build_config.dart).
#
# All variables are optional — omit any you don't need and the build simply
# skips it (the BYOK rung stays in its no-op default when the key is absent).
# ─────────────────────────────────────────────────────────────────────────────

# Dev-only: use the in-memory encrypted store so the capture → log → Day Board
# loop works in the browser. Production web keeps the honest
# WebEncryptedStoreStub (data lives and dies with the browser tab).
OPENPLATE_DEV_IN_MEMORY_STORE=true

# BYOK — your own OpenAI-compatible endpoint + key (Story 3.3 / FR7).
# The key is sent in the `Authorization` header only; it never leaves the
# app except to this endpoint.
OPENPLATE_BYOK_ENDPOINT_URL=https://openrouter.ai/api/v1
OPENPLATE_BYOK_MODEL=google/gemini-2.0-flash-exp:free
OPENPLATE_BYOK_API_KEY=