# ─────────────────────────────────────────────────────────────
# AI Nutrition Coach — root .gitignore
# Stack: React PWA (apps/web) + packages/core, pnpm workspace, Docker self-host.
# ─────────────────────────────────────────────────────────────

# ── OS / editor / IDE ────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# ── Secrets / credentials ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.jks
*.keystore
**/key.properties

# Test / coverage
coverage/

# ── Python (BMad tooling) ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# ── Node (tooling only) ──────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ── BMad / agent tooling ─────────────────────────────────────
# Installed skills + installer-managed module files are regenerable
# via the BMad installer — keep the repo to the team's authored
# configuration and project artifacts only.
.agents/

# Installer-managed BMad config (regenerated on every install)
_bmad/config.toml
_bmad/config.user.toml
_bmad/bmm/
_bmad/core/
_bmad/scripts/
_bmad/_config/
_bmad/render/

# BMad personal overrides only; team overrides stay tracked.
_bmad/custom/*.user.toml

# ── Temporary / misc ─────────────────────────────────────────
*.log
*.tmp
*.bak
# ── Impeccable design tooling (local-only artifacts) ─────────
.impeccable/review/
.impeccable/ref/
.impeccable/questions/
.impeccable/hook.cache.json

# ── JS workspace (apps/web, packages/core) ───────────────────
dist/
dist-e2e/
playwright-report/
test-results/
.vite/
*.tsbuildinfo

# ── React PWA: fetched + SHA-256-verified SQLite3 Multiple Ciphers wasm (scripts/fetch_web_sqlite3mc.sh) ──
apps/web/public/sqlite3mc/

# ── React PWA: fetched + SHA-256-verified zxing-wasm decoder (scripts/fetch_web_zxing_pwa.sh) ──
apps/web/public/zxing/

# ── React PWA: fetched + SHA-256-verified hash-wasm Argon2id build (scripts/fetch_web_argon2.sh) ──
apps/web/public/argon2/

# ── Documentation site (scripts/build-site.sh: landing + MkDocs docs + videos) ──
/site/
