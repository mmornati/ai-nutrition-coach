<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 6–11 (API 23–30) full-backup rules (security review D6).
  Excludes every domain; see data_extraction_rules.xml for the rationale.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
