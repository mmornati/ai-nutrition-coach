<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup / device-transfer rules (security review D6).

  OpenPlate keeps nothing in cloud backup or device-to-device transfer:
  the encrypted database is useless without its Keystore-bound key, the
  key cannot be transferred, and a restored database with no key would
  only strand the user (D7). Everything is excluded from both channels.
  `android:allowBackup="false"` in the manifest is the primary switch;
  this file is the explicit, auditable backstop for API 31+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
