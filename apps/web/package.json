{
  "name": "@anc/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "fetch:sqlite3mc": "bash ../../scripts/fetch_web_sqlite3mc.sh",
    "fetch:zxing": "bash ../../scripts/fetch_web_zxing_pwa.sh",
    "fetch:assets": "pnpm run fetch:sqlite3mc && pnpm run fetch:zxing",
    "dev": "pnpm run fetch:assets && vite",
    "build": "pnpm run fetch:assets && tsc -b && vite build && pnpm run precache",
    "precache": "node ../../tools/generate_precache_manifest.mjs dist",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "pnpm run fetch:assets && vitest run",
    "e2e": "pnpm run fetch:assets && playwright test",
    "test:dst": "TZ=Europe/Paris vitest run --project dom"
  },
  "dependencies": {
    "@anc/core": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "playwright-core": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vitest-axe": "0.1.0"
  }
}
