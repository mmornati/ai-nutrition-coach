# AI Nutrition Coach SPA server (rendered to /tmp/ai-nutrition-coach.conf at container start).
#
#   1. Serve the Vite release build from /usr/share/nginx/html on :8080.
#   2. SPA fallback to /index.html for client-side routes (FR11).
#   3. Correct caching (I5), derived from how Vite names its output:
#        - assets/*            content-hashed by Vite             -> immutable;
#        - sqlite3mc/<ver>/, zxing/<ver>/ versioned by path       -> immutable;
#        - index.html, sw.js, precache-manifest.json, manifest.webmanifest and
#          boot-guard.js carry no hash and decide what runs      -> no-cache;
#        - fonts/, icons/, licenses/, favicon.svg: unhashed names -> short cache.
#   4. The optional instance AI proxy under /ai/ (see below), off unless the operator sets it up.
#   5. The optional encrypted-backup relay under /sync/ (see below), off unless the operator turns on
#      the compose profile `sync`.
#   6. The security headers from ai-nutrition-coach-headers.inc on every response.

# mime.types has no entry for ttf/otf/mjs/webmanifest, so they would be served
# as application/octet-stream (a module script MUST be a JavaScript type) and
# gzip_types could not match them. `.js` stays what mime.types says.
types {
    font/ttf ttf;
    font/otf otf;
    text/javascript mjs;
    application/manifest+json webmanifest;
}

gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_proxied any;
gzip_comp_level 6;
gzip_types application/javascript text/javascript application/wasm application/json
           application/manifest+json text/css text/plain image/svg+xml font/ttf font/otf;

# GET and HEAD everywhere; POST only to the two AI proxy paths (chat, and voice transcription which
# also needs AI_PROXY_TRANSCRIPTION=1) and, for the encrypted-backup relay, POST to three login-ish
# paths and PUT to the vault: they exist only when the operator turned them on
# (40-render-ai-proxy.sh, 50-render-sync.sh), otherwise they are a plain 404.
map "$request_method $uri" $ai_nutrition_coach_method_ok {
    default                           0;
    "~^(GET|HEAD) "                   1;
    "POST /ai/v1/chat/completions"    1;
    "POST /ai/v1/audio/transcriptions" 1;
    "POST /sync/v1/salt"              1;
    "POST /sync/v1/signup"            1;
    "POST /sync/v1/login"             1;
    "PUT /sync/v1/vault"              1;
}

server {
    listen       8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Server-level headers so responses generated here (405 below, nginx's own
    # 400/414/...) carry them too; locations include the same file themselves
    # because add_header is not inherited into a location that has its own.
    include /tmp/ai-nutrition-coach-headers.inc;

    # A static site: read-only methods only, and no request bodies. The one exception is the
    # instance AI proxy's POST (below), whose location raises the body limit for itself and
    # rejects every other method; when the proxy is off that path is a plain 404.
    client_max_body_size 1k;
    if ($ai_nutrition_coach_method_ok = 0) { return 405; }

    # The instance AI proxy (docs/self-host.md "Offer AI to everyone on your instance"):
    # /ai/config.json and /ai/v1/chat/completions, or just 404s when it is off. Rendered at
    # container start because it holds the provider key (mode 0600).
    include /tmp/ai-nutrition-coach-ai-locations.inc;

    # The optional encrypted-backup relay (docs/self-host.md "Encrypted backup on your own server"):
    # /sync/config.json and /sync/v1/..., proxied to the relay container, or just 404s when it is
    # off. Rendered at container start.
    include /tmp/ai-nutrition-coach-sync-locations.inc;

    # The document, the web manifest and the boot guard: always revalidate so an
    # upgrade is picked up on the next load. (The SPA fallback below re-enters
    # this location through the internal redirect to /index.html.)
    location ~ ^/(index\.html|manifest\.webmanifest|boot-guard\.js)$ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        include /tmp/ai-nutrition-coach-headers.inc;
    }

    # The service worker and its precache manifest are RENDERED at container
    # start (30-render-sw.sh): the build id also covers the response headers,
    # so a CSP-only redeploy reaches installed apps. They are how an installed
    # app learns a new version exists: always revalidated (docs/pwa.md). The
    # worker is served from the root, so its scope is `/` and no
    # Service-Worker-Allowed header is needed.
    location = /sw.js {
        alias /tmp/ai-nutrition-coach-pwa/sw.js;
        add_header Cache-Control "no-cache";
        include /tmp/ai-nutrition-coach-headers.inc;
    }

    location = /precache-manifest.json {
        alias /tmp/ai-nutrition-coach-pwa/precache-manifest.json;
        add_header Cache-Control "no-cache";
        include /tmp/ai-nutrition-coach-headers.inc;
    }

    # Vite's output: every file name carries a content hash, so it is safe to
    # cache forever (a changed file is a new URL). try_files =404: a missing
    # asset is a real 404, never the app shell.
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /tmp/ai-nutrition-coach-headers.inc;
    }

    # The encrypted-store engine (scripts/fetch_web_sqlite3mc.sh) and the
    # self-hosted zxing-wasm decoder (scripts/fetch_web_zxing_pwa.sh) and the
    # hash-wasm Argon2id build (scripts/fetch_web_argon2.sh): the version is in
    # the path, so they are safe to cache forever.
    location ~ ^/sqlite3mc/[0-9][0-9.]*/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /tmp/ai-nutrition-coach-headers.inc;
    }

    location ~ ^/zxing/[0-9][0-9.]*/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /tmp/ai-nutrition-coach-headers.inc;
    }

    location ~ ^/argon2/[0-9][0-9.]*/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /tmp/ai-nutrition-coach-headers.inc;
    }

    # Unhashed static files (fonts, icons, licence texts, the favicon): short
    # cache + revalidate. Cache-Control is set without `always`, so a 404 is
    # never publicly cacheable.
    location ~ ^/(fonts|icons|licenses)/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=300, must-revalidate";
        include /tmp/ai-nutrition-coach-headers.inc;
    }

    location = /favicon.svg {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=300, must-revalidate";
        include /tmp/ai-nutrition-coach-headers.inc;
    }

    # Any other path that names a FILE (it has an extension) and is not in the
    # bundle is a real 404 -- the same rule the service worker applies to
    # navigations (no extension = a route). Routes never contain a dot.
    location ~ ^/.*\.[A-Za-z0-9]+$ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        include /tmp/ai-nutrition-coach-headers.inc;
    }

    # SPA fallback (FR11): any unmatched path serves the shell. The internal
    # redirect to /index.html re-enters the no-cache location above.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        include /tmp/ai-nutrition-coach-headers.inc;
    }
}
