# OpenPlate SPA server (rendered to /tmp/openplate.conf at container start).
#
#   1. Serve the release build from /usr/share/nginx/html on :8080.
#   2. SPA fallback to /index.html for client-side routes (FR11).
#   3. Correct caching (I5): Flutter's assets are NOT content-hashed, so only
#      files whose NAME carries a version are `immutable`; everything the
#      loader / engine / app code is coupled to is revalidated.
#   4. The security headers from openplate-headers.inc on every response.

# mime.types has no entry for ttf/otf, so gzip_types could not match them.
types {
    font/ttf ttf;
    font/otf otf;
}

gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_proxied any;
gzip_comp_level 6;
gzip_types application/javascript application/wasm application/json
           text/css text/plain image/svg+xml font/ttf font/otf;

server {
    listen       8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Server-level headers so responses generated here (405 below, nginx's own
    # 400/414/...) carry them too; locations include the same file themselves
    # because add_header is not inherited into a location that has its own.
    include /tmp/openplate-headers.inc;

    # A static site: read-only methods only, and no request bodies.
    client_max_body_size 1k;
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }

    # Entry points, loader, app code, OpenPlate's service worker (sw.js), the
    # web manifest and the precache manifest: always revalidate so an upgrade
    # is picked up on the next load (the old `immutable 7d` on main.dart.js
    # served stale code after upgrades). sw.js and precache-manifest.json MUST
    # be no-cache: they are how the installed app learns a new version exists
    # (docs/pwa.md). The worker is served from the root, so its scope is `/`
    # and no Service-Worker-Allowed header is needed.
    location ~ ^/(index\.html|flutter_bootstrap\.js|flutter\.js|main\.dart\.js|flutter_service_worker\.js|manifest\.json|version\.json)$ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        include /tmp/openplate-headers.inc;
    }

    # The service worker and its precache manifest are RENDERED at container
    # start (30-render-sw.sh): the build id also covers the response headers,
    # so a CSP-only redeploy reaches installed apps. Always revalidated.
    location = /sw.js {
        alias /tmp/openplate-pwa/sw.js;
        add_header Cache-Control "no-cache";
        include /tmp/openplate-headers.inc;
    }

    location = /precache-manifest.json {
        alias /tmp/openplate-pwa/precache-manifest.json;
        add_header Cache-Control "no-cache";
        include /tmp/openplate-headers.inc;
    }

    # Versioned by filename (sqlite3mc-<ver>.wasm): safe to cache forever.
    location ~ ^/sqlite3mc-[0-9][0-9.]*\.wasm$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /tmp/openplate-headers.inc;
    }

    # The self-hosted zxing-wasm decoder (scripts/fetch_web_zxing.sh): the
    # version is in the path, so it is safe to cache forever.
    location ~ ^/zxing/[0-9][0-9.]*/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /tmp/openplate-headers.inc;
    }

    # CanvasKit / skwasm are coupled to the exact main.dart.js build but not
    # versioned in their path: revalidate (ETag -> cheap 304).
    location /canvaskit/ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        include /tmp/openplate-headers.inc;
    }

    # Engine-coupled asset data (manifests, shader bundles, licence text):
    # revalidate like the app code.
    location ~ ^/assets/(.+\.(bin|json)|shaders/.*|NOTICES)$ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        include /tmp/openplate-headers.inc;
    }

    # Unhashed static assets (fonts, icons, images): short cache + revalidate.
    # try_files =404: a missing asset must 404, not return index.html. Cache-Control
    # is set without `always`, so a 404 is never publicly cacheable.
    location ~ ^/(assets|icons|fallback-fonts)/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=300, must-revalidate";
        include /tmp/openplate-headers.inc;
    }

    location = /favicon.png {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=300, must-revalidate";
        include /tmp/openplate-headers.inc;
    }

    # SPA fallback (FR11): any unmatched path serves the shell. The internal
    # redirect to /index.html re-enters the no-cache location above.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        include /tmp/openplate-headers.inc;
    }
}
