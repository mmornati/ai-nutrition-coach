# AI Nutrition Coach behind an existing Traefik + Authentik, reached through a
# Cloudflare Tunnel (docs/self-host.md "Behind Authentik").
#
#   cd infra
#   cp server.env.example .env          # .env is git-ignored; edit the values
#   docker compose up -d --build        # builds infra/Dockerfile from this checkout
#   docker compose ps                   # "healthy" within a few seconds
#
# Update:  git -C .. pull --ff-only && docker compose up -d --build
#
# Compose reads this file as data (it is never executed). By default there are
# NO SECRETS here: the container holds none and needs none; each person types
# their AI key into the app and it stays encrypted in their browser. The ONE
# exception is the optional instance-wide AI key at the bottom (off by default):
# if you turn it on, this file holds a secret, so `chmod 600 .env`, keep it out
# of version control, and read docs/self-host.md "Offer AI to everyone on your
# instance".

# The compose files, from this directory: the Traefik stack, the sign-in, and
# Authentik's outpost route. A stable project name, whatever the folder.
COMPOSE_FILE=docker-compose.traefik.yml:docker-compose.traefik-auth.yml:docker-compose.traefik-authentik.yml
COMPOSE_PROJECT_NAME=ai-nutrition-coach
AI_NUTRITION_COACH_IMAGE_TAG=ai-nutrition-coach:local

# Public name (Cloudflare Tunnel public hostname -> Traefik).
AI_NUTRITION_COACH_DOMAIN=ai-nutrition-coach.mornati.ovh

# Traefik: the network and entrypoint your other services use. The tunnel
# talks plain HTTP to Traefik, so the router does no TLS itself; Cloudflare
# serves HTTPS to the browser.
AI_NUTRITION_COACH_TRAEFIK_NETWORK=traefik-network
AI_NUTRITION_COACH_TRAEFIK_ENTRYPOINT=insecure
AI_NUTRITION_COACH_TRAEFIK_TLS=false

# Forward auth: the middleware and the outpost service already defined in
# Traefik's file provider.
AI_NUTRITION_COACH_TRAEFIK_AUTH_MIDDLEWARE=authentik@file
AI_NUTRITION_COACH_AUTHENTIK_OUTPOST_SERVICE=sso@file

# The AI endpoint the browser may call (CSP connect-src): origins only,
# space-separated. Must match Settings -> Your AI in the app.
AI_NUTRITION_COACH_CONNECT_SRC_EXTRA=https://openrouter.ai

# off (default) | on (address truncated, no User-Agent) | full
AI_NUTRITION_COACH_ACCESS_LOG=off

# ── Instance-wide AI (optional, OFF by default) ─────────────────────────────
# One OpenAI-compatible endpoint + key + model for EVERYONE who can open this
# instance: photo recognition works without each person bringing a key. The key
# stays on the server: nginx adds it to the request and the browser never sees
# it (docs/self-host.md "Offer AI to everyone on your instance").
#
# COST AND ABUSE: anyone who can reach this instance can spend this key, up to
# the rate limit below. Put the instance behind a sign-in or an allow-list (the
# traefik-auth / traefik-authentik / traefik-allowlist overlays), and set a
# spend cap at your provider.
#
# 1 turns it on. Anything else, or an empty key, keeps it off.
AI_PROXY_ENABLED=0
# The provider's OpenAI-compatible base address (https only; the app adds /chat/completions).
#AI_PROXY_UPSTREAM=https://openrouter.ai/api/v1
# The provider key. Never commit it. Letters, digits and . _ ~ + / = : - only.
#AI_PROXY_KEY=
# The model every request uses. The server forces it: a visitor cannot pick another.
#AI_PROXY_MODEL=google/gemini-2.0-flash-001
# What people are told their photos go to, after this server (default: the upstream host).
#AI_PROXY_LABEL=OpenRouter
# Optional limits. Both apply to every request: per client address as the container sees it
# (behind Traefik or Caddy that is the proxy, so it is effectively the whole instance, and the
# concurrent-request limit with it) and for the whole instance.
#AI_PROXY_RATE=10r/m
#AI_PROXY_RATE_ALL=30r/m
#AI_PROXY_BURST=5
#AI_PROXY_CONN=2
# Cap on a reply. Reasoning models want max_completion_tokens instead of max_tokens.
#AI_PROXY_MAX_TOKENS=2000
#AI_PROXY_TOKEN_PARAM=max_tokens
