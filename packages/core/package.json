{
  "name": "@anc/core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run && pnpm run test:dst",
    "test:dst": "TZ=Europe/Paris REQUIRE_DST=1 vitest run test/calendar-day.test.ts",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.7"
  }
}
