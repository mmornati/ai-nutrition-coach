#!/usr/bin/env bash
# Opt-in pre-commit hook: the FAST gates only (format, lint, typecheck, release-posture gates,
# scanner self-tests). The full gate (unit tests, build, bundle scans) is `pnpm verify`, which CI
# runs on every pull request.
# Install:  ln -sf ../../scripts/git-hooks/pre-commit .git/hooks/pre-commit
# Skip once (do not make a habit): git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
pnpm format:check
pnpm lint
pnpm typecheck
pnpm gates
pnpm selftest:scanners
