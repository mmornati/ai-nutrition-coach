#!/usr/bin/env bash
# Opt-in pre-commit hook: runs the full verification gate (scripts/verify.sh).
# Install:  ln -sf ../../scripts/git-hooks/pre-commit .git/hooks/pre-commit
# Skip once (do not make a habit): git commit --no-verify
set -euo pipefail
exec "$(git rev-parse --show-toplevel)/scripts/verify.sh"
